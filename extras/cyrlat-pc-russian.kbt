# CyrLat keyboard layout: Russian JCUKEN as on a PC, for WindEmu.
# Comments here must not hold quotes or angle brackets, which confuse CyrLat
#
# WindEmu types the punctuation of a PC with Fn and Shift combinations
# of the Psion, so the codes and modifiers below are what reach CyrLat.
# Load it in the CyrLat Control Center: Keyboard layouts, Edit the Cyr
# layout, Map table, then hold Fn while tapping Load.
# Codes are CP-1251.

# letters
0x71 -> 0xE9
0x77 -> 0xF6
0x65 -> 0xF3
0x72 -> 0xEA
0x74 -> 0xE5
0x79 -> 0xED
0x75 -> 0xE3
0x69 -> 0xF8
0x6F -> 0xF9
0x70 -> 0xE7
0x61 -> 0xF4
0x73 -> 0xFB
0x64 -> 0xE2
0x66 -> 0xE0
0x67 -> 0xEF
0x68 -> 0xF0
0x6A -> 0xEE
0x6B -> 0xEB
0x6C -> 0xE4
0x7A -> 0xFF
0x78 -> 0xF7
0x63 -> 0xF1
0x76 -> 0xEC
0x62 -> 0xE8
0x6E -> 0xF2
0x6D -> 0xFC
<Shft>0x51 -> 0xC9
<Shft>0x57 -> 0xD6
<Shft>0x45 -> 0xD3
<Shft>0x52 -> 0xCA
<Shft>0x54 -> 0xC5
<Shft>0x59 -> 0xCD
<Shft>0x55 -> 0xC3
<Shft>0x49 -> 0xD8
<Shft>0x4F -> 0xD9
<Shft>0x50 -> 0xC7
<Shft>0x41 -> 0xD4
<Shft>0x53 -> 0xDB
<Shft>0x44 -> 0xC2
<Shft>0x46 -> 0xC0
<Shft>0x47 -> 0xCF
<Shft>0x48 -> 0xD0
<Shft>0x4A -> 0xCE
<Shft>0x4B -> 0xCB
<Shft>0x4C -> 0xC4
<Shft>0x5A -> 0xDF
<Shft>0x58 -> 0xD7
<Shft>0x43 -> 0xD1
<Shft>0x56 -> 0xCC
<Shft>0x42 -> 0xC8
<Shft>0x4E -> 0xD2
<Shft>0x4D -> 0xDC

# the punctuation keys right of the letters, and Shift with them
<Func>0x5B -> 0xF5    # left bracket
<Func>0x7B -> 0xD5    # Shift left bracket
<Func>0x5D -> 0xFA    # right bracket
<Func>0x7D -> 0xDA    # Shift right bracket
<Func>0x3B -> 0xE6    # semicolon
<Shft><Func>0x3A -> 0xC6    # Shift semicolon
0x27 -> 0xFD    # apostrophe
<Shft>0x22 -> 0xDD    # Shift apostrophe
0x2C -> 0xE1    # comma
<Func>0x3C -> 0xC1    # Shift comma
0x2E -> 0xFE    # full stop
<Func>0x3E -> 0xDE    # Shift full stop
<Shft>0x2F -> 0x2E    # slash
<Shft>0x3F -> 0x2C    # Shift slash
<Func>0x5C -> 0xB8    # backslash
<Shft><Func>0x5C -> 0xA8    # Shift+backslash
<Shft>0xA3 -> 0xB9    # Shift+3
<Shft>0x24 -> 0x3B    # Shift+4
<Shft>0x5E -> 0x3A    # Shift+6
<Shft>0x26 -> 0x3F    # Shift+7
